PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_api

# Redis — single connection string. Supports auth and TLS:
#   redis://localhost:6379
#   redis://:password@host:6379/0
#   rediss://user:password@host:6380   (TLS)
REDIS_URL=redis://localhost:6379

# Encryption — AES-256-GCM key for storing access tokens at rest.
# Must be a base64-encoded 32-byte key, e.g. `openssl rand -base64 32`.
ENCRYPTION_KEY=

# JWT — secret used to sign internal API tokens
JWT_SECRET=

# SSO — DraskenLabs OAuth 2.0 Authorization Code + PKCE (confidential client).
# This API is a confidential client: the browser is redirected to the SSO login
# UI by the web app, and this API only performs the server-side code→token
# exchange (POST {SSO_API_URL}/auth/token) so the client secret never reaches
# the browser.
#
# Base URL of the SSO API — the token exchange endpoint lives under it.
SSO_API_URL=https://iam.draskenapis.com
# Public OAuth client id registered for this app.
SSO_CLIENT_ID=
# Confidential client secret — shown once at client registration. Keep it server-side only.
SSO_CLIENT_SECRET=
# Redirect URI registered for this SSO client. Must EXACTLY match the value the
# web app redirects with (its /auth/callback route) and is sent back here at the
# token exchange. e.g. local dev: http://localhost:5173/auth/callback
SSO_REDIRECT_URI=https://wa.draskenapis.com/auth/callback

# Meta / WhatsApp Business Platform
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# Webhooks
WEBHOOK_VERIFY_TOKEN=

# How long raw Meta webhook envelopes and the outbound delivery log are kept.
# 30 is what the published Privacy Policy promises; both hold message content.
WEBHOOK_EVENT_RETENTION_DAYS=30

# Message history is kept to the window each plan publishes (Starter 30 days,
# Growth 90, Business a year). Deleting a customer's own record of what they
# sent is destructive, so the sweep only counts and logs until this is "true".
PLAN_RETENTION_ENFORCED=false

# Outbound webhooks — events forwarded to endpoints customers register.
# How long to wait on their server before an attempt counts as failed.
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# Set to "true" ONLY for local development, where the endpoint under test is
# http://localhost:4000/hooks. In production this is what stops someone
# registering http://169.254.169.254/ and reading the delivery log.
WEBHOOK_ALLOW_INSECURE_URLS=false

# Set to "true" to enable the dev-only POST /connect/manual endpoint (wire a
# WABA with a token directly, e.g. Meta's test number). Leave false in prod.
ALLOW_MANUAL_CONNECT=false

# Set to "true" to serve the API docs at /swagger/docs and /swagger/json. On
# locally so there is something to read while developing; leave it off in prod,
# where the docs are a map of every endpoint and payload for whoever finds them.
SWAGGER_ENABLED=true

# Firebase Cloud Messaging — push notifications to the console.
#
# The whole service-account JSON, base64-encoded, so the deployment needs a
# single Secret value and no mounted file:
#   base64 -w0 serviceAccountKey.json          (Linux)
#   base64 -i serviceAccountKey.json | tr -d '\n'   (macOS)
#
# Download the JSON from Firebase console → Project settings → Service accounts
# → Generate new private key. Leave this empty to run without push: the API
# starts normally, logs that notifications are disabled, and every send is a
# no-op.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---------------------------------------------------------------------------
# Amazon SES — outgoing email
# ---------------------------------------------------------------------------
# Leave AWS_REGION or SES_FROM_ADDRESS empty to run without email: the API
# starts normally, logs that mail is disabled, and every send is a no-op.
AWS_REGION=eu-west-1
# Omit both keys when the pod carries an IAM role (IRSA) — the AWS SDK then
# resolves credentials itself, which avoids a long-lived secret entirely.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# A verified identity in SES. Verify the whole domain with DKIM rather than a
# single address, and publish SPF and DMARC records for it.
SES_FROM_ADDRESS=no-reply@draskenlabs.com
SES_FROM_NAME=WhatsApp Console
# Where replies land — a mailbox a person actually reads.
SES_REPLY_TO=support@draskenlabs.com
# Configuration set wired to an SNS topic for bounces and complaints. Without
# it, POST /mail/events never fires and dead addresses are never suppressed.
SES_CONFIGURATION_SET=whatsapp-console
# NOTE: a new SES account is in the sandbox and will only deliver to verified
# addresses. Request production access before launch.

# Absolute base URL of the console — used for links inside emails.
APP_BASE_URL=https://wa.draskenapis.com

# Where the console's support form delivers. Every topic goes to this one
# mailbox, tagged with the topic — privacy → support+privacy@ — so it can be
# filtered on the To: header. The `support` topic is left untagged.
SUPPORT_EMAIL=support@draskenlabs.com
# "false" for a provider without +tag subaddressing: every topic then goes to
# SUPPORT_EMAIL unchanged.
SUPPORT_EMAIL_TAGGING=true
# Per-topic overrides — set one to route that topic to its own mailbox instead
# of the tagged address above.
# PRIVACY_EMAIL=privacy@draskenlabs.com
# SECURITY_EMAIL=security@draskenlabs.com
# ABUSE_EMAIL=abuse@draskenlabs.com
# LEGAL_EMAIL=legal@draskenlabs.com

# Enables POST /mail/broadcast (policy-change, sub-processor and breach
# notices). Leave empty to keep the endpoint disabled.
MAIL_ADMIN_TOKEN=

# Enables the operator endpoints under /agency/internal — converting an
# organisation to an agency, and taking a client on or letting one go. Leave
# empty to keep them disabled.
AGENCY_ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Razorpay — subscriptions
# ---------------------------------------------------------------------------
# Optional, like push and email: without a key pair the API runs normally,
# sells nothing and charges nobody for the Messaging API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Which Razorpay plan charges for each published tier, as `code:plan_id` pairs.
# Applied to the Plan table at boot — the id belongs to the tier, not to the
# deployment, which is what lets a negotiated plan carry one of its own. Create one plan per tier in the SAME
# Razorpay account as the keys above, at the price the pricing page shows:
#   starter ₹499, growth ₹999, business ₹1,999 — monthly.
# A tier with no id here cannot be bought: the price list marks it unavailable
# and the console offers to talk instead of opening a checkout that would fail.
RAZORPAY_PLAN_IDS=

# Where the Razorpay API lives. Leave unset in every real deployment — it
# exists so the integration suite can point the same code at a stand-in on
# localhost instead of sending test traffic to Razorpay.
# RAZORPAY_API_BASE=https://api.razorpay.com/v1

# ---------------------------------------------------------------------------
# Invoicing
# ---------------------------------------------------------------------------
# Every captured payment raises a numbered invoice and emails it to whoever
# took the mandate out, with the PDF attached. For an agency that is the
# agency — one mandate covers several clients, and the document itemises them.
# All of the below is optional: unset, a deployment still invoices — it prints
# no seller address and shows no tax line.

# The book this deployment writes in: the `WAC` in INV-WAC-2627-0001, and in
# RCT-WAC-2627-0001. Set it once. Changing it after documents exist splits one
# statutory series in two. Invoices and receipts share the series name but
# never the counter — a receipt must not be able to leave a gap in the invoice
# series, which is the one an auditor reads for gaps.
INVOICE_SERIES=WAC

# Which local midnight the financial year turns at. India's runs 1 April to
# 31 March, so a payment captured at 03:00 IST on 1 April is the new year's
# first invoice even though it is still 31 March in UTC.
INVOICE_TIMEZONE=Asia/Kolkata

# Tax rate in basis points — 1800 is 18% GST. Leave at 0 (or unset) if the
# company is not registered: no tax line is printed at all. The published price
# is treated as inclusive, so the tax is worked back out of what was charged
# rather than added on top of it.
#
# Turning this on is a dated decision, not a toggle: invoices raised before and
# after must not disagree, and an invoice already issued is never restated.
INVOICE_TAX_RATE_BPS=1800
INVOICE_TAX_LABEL=GST

# How the tax divides is decided per invoice, by comparing the customer's state
# to ours: inside our state it is CGST plus SGST at half the rate each, outside
# it is IGST at the whole rate. Ours is read from the first two characters of
# INVOICE_SELLER_GSTIN below — deliberately not its own variable, because a
# separate setting could only ever disagree with the registration, and a
# deployment where the two disagree charges the wrong heads of tax to every
# customer in its own state without anything failing.
#
# The customer's state is a column on their organisation, entered in the
# console. Where they have not given one the supply is treated as local: IGST
# wrongly charged on a local supply is the harder error to unwind.

# The service classification the supply is made under, printed against every
# line. 998314 is "information technology infrastructure and network
# management services".
INVOICE_SAC_CODE=998314

# Who the invoice is from. The address is pipe-separated: one line per segment.
INVOICE_SELLER_NAME=Drasken Labs Private Limited
INVOICE_SELLER_ADDRESS=
INVOICE_SELLER_EMAIL=billing@draskenlabs.com
INVOICE_SELLER_WEBSITE=https://draskenlabs.com
# Required to charge GST: it is what states the tax is ours to collect, and its
# first two characters are the state we supply from.
# INVOICE_SELLER_GSTIN=
# INVOICE_SELLER_PAN=
# INVOICE_SELLER_CIN=
