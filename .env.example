PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/whatsapp_api

# Redis — single connection string. Supports auth and TLS:
#   redis://localhost:6379
#   redis://:password@host:6379/0
#   rediss://user:password@host:6380   (TLS)
REDIS_URL=redis://localhost:6379

# Encryption — AES-256-GCM key for storing access tokens at rest.
# Must be a base64-encoded 32-byte key, e.g. `openssl rand -base64 32`.
ENCRYPTION_KEY=

# JWT — secret used to sign internal API tokens
JWT_SECRET=

# SSO — DraskenLabs OAuth 2.0 Authorization Code + PKCE (confidential client).
# This API is a confidential client: the browser is redirected to the SSO login
# UI by the web app, and this API only performs the server-side code→token
# exchange (POST {SSO_API_URL}/auth/token) so the client secret never reaches
# the browser.
#
# Base URL of the SSO API — the token exchange endpoint lives under it.
SSO_API_URL=https://iam.draskenapis.com
# Public OAuth client id registered for this app.
SSO_CLIENT_ID=
# Confidential client secret — shown once at client registration. Keep it server-side only.
SSO_CLIENT_SECRET=
# Redirect URI registered for this SSO client. Must EXACTLY match the value the
# web app redirects with (its /auth/callback route) and is sent back here at the
# token exchange. e.g. local dev: http://localhost:5173/auth/callback
SSO_REDIRECT_URI=https://wa.draskenapis.com/auth/callback

# Meta / WhatsApp Business Platform
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# Webhooks
WEBHOOK_VERIFY_TOKEN=

# Set to "true" to enable the dev-only POST /connect/manual endpoint (wire a
# WABA with a token directly, e.g. Meta's test number). Leave false in prod.
ALLOW_MANUAL_CONNECT=false
