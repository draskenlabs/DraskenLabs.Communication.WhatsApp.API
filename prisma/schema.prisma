// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  ssoId     String   @unique
  /// Contact details copied from SSO at sign-in. Held locally because every
  /// notification email is triggered by a webhook or a scheduled job, where
  /// there is no user token to read the SSO profile with.
  email     String?
  firstName String?
  lastName  String?
  /// Whether this person may use the operator console at `/admin`.
  ///
  /// A property of the person, not of an organisation: an operator opens
  /// organisations they are not a member of, which is the whole point and is a
  /// privilege boundary rather than anything a plan sells. Never self-serve —
  /// the first one is seeded by migration, and after that only an existing
  /// admin can grant it.
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  UserWhatsapp    UserWhatsapp[]
  UserApiKey      UserApiKey[]
  Waba            Waba[]
  Message         Message[]
  DeviceToken     DeviceToken[]
  Notification    Notification[]
  WebhookEndpoint WebhookEndpoint[]

  NotificationPreference NotificationPreference?
}

model UserWhatsapp {
  id          Int      @id @default(autoincrement())
  userId      Int
  businessId  String
  wabaId      String
  accessToken String // Encrypted (AES-256-GCM)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  waba Waba @relation(fields: [wabaId], references: [wabaId])

  @@unique([userId, wabaId])
}

model Waba {
  id                       Int      @id @default(autoincrement())
  wabaId                   String   @unique
  name                     String?
  currency                 String?
  timezoneId               String?
  messageTemplateNamespace String?
  /// Who connected it first, and into which organisation. Kept for audit and
  /// for the delete check; membership is `WabaOrganisation`, not this.
  userId                   Int
  ssoOrgId                 String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user             User               @relation(fields: [userId], references: [id])
  UserWhatsapp     UserWhatsapp[]
  WabaPhoneNumber  WabaPhoneNumber[]
  InboundMessage   InboundMessage[]
  MessageTemplate  MessageTemplate[]
  UserApiKey       UserApiKey[]
  Subscription     Subscription[]
  WabaOrganisation WabaOrganisation[]
  WebhookEndpoint  WebhookEndpoint[]
  Conversation     Conversation[]
}

/// Which organisations have connected a WhatsApp Business Account.
///
/// The account itself is Meta's and is shared — its name, currency and phone
/// numbers are the same whoever looks. What is per organisation is the
/// *connection*: whether this org has it, who connected it there, and by
/// extension what that org may do with it. Before this table the Waba row was
/// the connection, so a second organisation connecting the same account
/// updated the first one's row instead of gaining its own.
model WabaOrganisation {
  id       Int    @id @default(autoincrement())
  wabaId   String
  ssoOrgId String
  /// Who connected it for this organisation. Their token is the one used.
  userId   Int

  /// The organisation's display name, copied at connect.
  ///
  /// Organisations live in the SSO, so a webhook or a billing cron has an id
  /// and no way to turn it into a name. This is the durable copy behind the
  /// Redis cache — nullable because a row written before this existed has none.
  orgName String?

  createdAt DateTime @default(now())

  waba Waba @relation(fields: [wabaId], references: [wabaId], onDelete: Cascade)

  @@unique([wabaId, ssoOrgId])
  @@index([ssoOrgId])
}

model WabaPhoneNumber {
  id                     Int       @id @default(autoincrement())
  phoneNumberId          String    @unique
  verifiedName           String
  codeVerificationStatus String
  displayPhoneNumber     String
  qualityRating          String
  platformType           String
  throughputLevel        String
  lastOnboardedTime      DateTime?
  wabaId                 String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  waba Waba @relation(fields: [wabaId], references: [wabaId])
}

model UserApiKey {
  id        Int      @id @default(autoincrement())
  userId    Int
  ssoOrgId  String
  accessKey String   @unique
  secretKey String // Encrypted
  /// The WABA this key may act on. A key reaches one account, never the whole
  /// organisation. Nullable only for keys issued before scoping existed, and
  /// those are refused at authentication rather than left org-wide.
  wabaId    String?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id])
  waba Waba? @relation(fields: [wabaId], references: [wabaId])

  @@index([wabaId])
}

/// A published plan: what it costs, and what it allows.
///
/// The price list is data, not code. The console reads this table to render
/// the pricing page, and the limits are columns rather than a JSON blob
/// because they are the thing enforcement asks about — "how many numbers may
/// this account have" is a query, not a document to parse.
///
/// Amounts are in paise, like everything else that touches money here.
model Plan {
  id       Int    @id @default(autoincrement())
  /// Stable identifier used in seeds, analytics and URLs: starter, growth,
  /// business, agency. The primary key is an integer for the foreign keys;
  /// this is what a human names a plan by.
  code     String @unique
  name     String
  /// Who the plan is for, in one line.
  audience String

  /// Per WABA per month. Null where pricing is quoted rather than published.
  price                 Int?
  /// Shown instead of an amount when `price` is null, e.g. "Custom".
  priceLabel            String?
  currency              String  @default("INR")
  /// What the price is per, e.g. "/WABA/month".
  unit                  String
  /// Every WABA includes one number; each additional one costs this a month.
  additionalNumberPrice Int?

  /// Every WABA includes one number; each additional one costs
  /// `additionalNumberPrice` a month. Each WABA beyond `includedWabas` costs
  /// this. Null on a plan that does not sell them.
  additionalWabaPrice Int?

  /// What the price includes. Beyond these the add-on price applies and
  /// nothing is refused — they are inclusion counts, not ceilings. Null means
  /// nothing is included, so everything bills.
  includedWabas               Int?
  includedPhoneNumbersPerWaba Int?
  /// Client organisations an agency plan includes. Null on every other plan,
  /// which has no clients to count.
  includedClients             Int?

  /// Limits that refuse rather than bill. Null means no number on this plan.
  maxTeamMembers       Int?
  maxWebhookEndpoints  Int?
  maxApiKeysPerWaba    Int?
  maxContacts          Int?
  /// Messages a single API key may send in a minute.
  maxMessagesPerMinute Int?
  /// How long message and webhook-event history is kept, in days.
  historyDays          Int?

  /// Which tier beats which, when an organisation holds more than one.
  ///
  /// Price cannot answer this: a quoted plan has none, and `price ?? 0` sorts
  /// the most expensive customer we have as the cheapest.
  rank Int @default(0)

  /// The organisation this plan belongs to, or null for a published tier.
  ///
  /// A negotiated deal is a plan of its own — its own limits, price and
  /// Razorpay id — and it must never appear on the public price list, so every
  /// unauthenticated read filters on this being null.
  ssoOrgId String?

  /// The most this customer has agreed to be debited in a month.
  ///
  /// Sizes the payment mandate, never the invoice: a mandate authorises up to
  /// an amount, and overage that lifts a bill past it is refused by the bank as
  /// a failed debit rather than an error we can raise. Null on published tiers,
  /// whose price is their own ceiling.
  mandateCeiling Int?

  /// The Razorpay plan a subscription on this tier is created against. Never
  /// leaves the API: the console is told a price, not a provider's id.
  razorpayPlanId String? @unique

  /// The plan this one builds on, so a card can say "Everything in Growth,
  /// plus:" without repeating the tier below it.
  inheritsPlanId Int?
  /// The one plan the pricing page highlights.
  recommended    Boolean @default(false)
  /// subscribe | contact — Agency is quoted, so it gets an email, not a
  /// checkout.
  ctaKind        String  @default("subscribe")
  ctaLabel       String
  sortOrder      Int     @default(0)
  /// A withdrawn plan stays here for the subscriptions still on it; it simply
  /// stops being offered.
  active         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inherits      Plan?          @relation("PlanInheritance", fields: [inheritsPlanId], references: [id], onDelete: Restrict)
  inheritedBy   Plan[]         @relation("PlanInheritance")
  features       PlanFeature[]
  subscriptions  Subscription[]       @relation("SubscriptionPlan")
  billingGroups  AgencyBillingGroup[] @relation("BillingGroupPlan")
  /// Subscriptions that move onto this plan at their next renewal.
  pendingFor    Subscription[] @relation("SubscriptionPendingPlan")

  @@index([active, sortOrder])
  @@index([ssoOrgId])
}

/// What this product needs to know about an organisation.
///
/// Organisations live in the SSO, so this is an annotation rather than a copy:
/// the id is the SSO's, and every column here is a fact about how *we* treat
/// that organisation. One row per organisation we have anything to say about.
/// What an operator did, when, and to whom.
///
/// Written by every mutation the admin console makes. The actor's email is
/// copied rather than joined: the row has to keep naming who did it after the
/// account is gone, which is exactly when somebody comes looking.
///
/// `before` and `after` hold only the fields that changed, so the row says what
/// the change *was* rather than merely that one happened — "who turned this
/// customer's limit up" is the question these get asked.
model AdminAuditLog {
  id Int @id @default(autoincrement())

  actorUserId Int
  actorEmail  String?

  /// A verb in the past tense, e.g. `plan.updated`, `admin.granted`.
  action String

  /// What was acted on: `organisation`, `plan`, `user`.
  targetType String
  targetId   String

  /// One line a human can read in a list without opening anything.
  summary String

  before Json?
  after  Json?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([actorUserId])
}

model OrganisationSettings {
  ssoOrgId String @id

  /// The agency that pays for this organisation, or null for everyone else.
  ///
  /// A client belongs to at most one agency, which is why this is a column on
  /// the client rather than a join table. An organisation with this set must
  /// never be an agency itself: one level, no chains.
  agencyOrgId String?

  /// Whether this organisation manages clients. Set by us, never self-serve —
  /// an agency can enter organisations it is not a member of, which is a
  /// privilege boundary rather than a plan feature.
  isAgency Boolean @default(false)

  /// What the agency calls this client, for its own switcher and reporting.
  clientName String?

  /// Who marked this an agency, and when. The row that explains why a user
  /// could read another organisation's messages.
  convertedBy Int?
  convertedAt DateTime?

  /// Bumped whenever the payer changes or their subscription does.
  ///
  /// Access is cached per organisation *and* account, so one agency's payment
  /// failing has to darken every client of theirs. Enumerating those keys is
  /// fine at five clients and a problem at five hundred; the version is part of
  /// the cache key instead, so a single increment orphans all of them at once.
  payerVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyOrgId])
}

/// One bullet on a plan card, in the order it is published.
///
/// Its own table rather than a string array: the list is what the pricing page
/// renders line by line, and a row per line is what lets one be reordered or
/// withdrawn without rewriting the plan.
model PlanFeature {
  id        Int    @id @default(autoincrement())
  planId    Int
  label     String
  sortOrder Int    @default(0)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
}

/// Razorpay's own subscription states, kept verbatim so a support question can
/// be answered by comparing this row against their dashboard.
enum SubscriptionStatus {
  /// Created, but the customer has not authorised the mandate yet.
  created
  /// Mandate registered; the first charge has not landed.
  authenticated
  active
  /// A charge failed and Razorpay is retrying.
  pending
  /// Retries exhausted.
  halted
  cancelled
  /// Ran to its agreed number of cycles.
  completed
  expired
  /// Replaced by the organisation's subscription, and no longer answered for
  /// here. Not `cancelled`: the mandate may still be live at Razorpay, and
  /// dropping our row would not stop it debiting. A human reconciles it.
  superseded
}

/// One subscription per WhatsApp Business Account: a flat monthly fee per
/// account for calling the Messaging API against it. API keys are scoped to a
/// WABA, so the key's account is the one that has to be paid for.
model Subscription {
  id Int @id @default(autoincrement())

  /// The account this pays for. Null only once that account has been deleted,
  /// which leaves the row as billing history and grants nothing.
  wabaId   String?
  /// The organisation paying. An account can be connected by more than one, and
  /// each pays for its own use of it — so this, with `wabaId`, is the identity
  /// of a subscription.
  ssoOrgId String

  razorpayCustomerId     String?
  /// The provider subscription this is charged on, when it has one of its own.
  ///
  /// Null for a client an agency pays for: those are charged through a shared
  /// subscription with a quantity, held on `billingGroup`. Postgres treats
  /// NULLs as distinct in a unique index, so the constraint still holds for
  /// every row that does name one.
  razorpaySubscriptionId String? @unique
  /// The Razorpay plan charged, recorded per subscription so a later price
  /// change cannot rewrite what an existing customer agreed to.
  planId                 String
  /// Which published plan this is, when it was sold from the price list.
  ///
  /// Null only where `planId` names a Razorpay plan no published tier claims:
  /// subscriptions taken out before the price list existed are adopted at boot
  /// by matching that id, so an existing customer is held to the tier they are
  /// actually paying for rather than to the cheapest one on offer.
  planRefId              Int?

  /// A tier chosen but not yet in force — a downgrade, which takes effect at
  /// the end of the month already paid for rather than cutting it short.
  ///
  /// Limits and charges follow `planRefId` until Razorpay says the change has
  /// happened; this is what lets the console say "Starter from 14 September"
  /// in the meantime.
  pendingPlanRefId Int?
  /// When the pending tier starts — the end of the paid month, as it stood
  /// when the change was asked for.
  pendingPlanAt    DateTime?

  status SubscriptionStatus @default(created)

  currentStart DateTime?
  /// End of the month already paid for. Access runs to here whatever the
  /// status — that is what makes "cancel any time" mean "cancel at the end of
  /// the month you have paid for".
  currentEnd   DateTime?

  /// Set when the customer cancels: no further debit, access until currentEnd.
  cancelAtCycleEnd Boolean   @default(false)
  cancelledAt      DateTime?

  /// Razorpay's hosted authorisation page. Only useful until the mandate is
  /// registered, and cleared once it is.
  shortUrl String?

  /// An upgrade the customer has been asked to authorise but has not yet.
  ///
  /// A Razorpay mandate is authorised for a fixed amount, so moving up a tier
  /// means a second subscription and a second authorisation. Both exist until
  /// they approve it: the old one is what they are still paying for and still
  /// entitled to, and it is cancelled only once the new one is live. Null for
  /// a downgrade, which needs no new mandate.
  pendingRazorpaySubscriptionId String? @unique
  /// That subscription's hosted authorisation page, as Checkout's fallback.
  pendingShortUrl               String?

  /// The organisation paying for this, when it is not the one using it.
  ///
  /// Null means self-paid, which every subscription was until agencies could
  /// buy for their clients. `ssoOrgId` is who it entitles; this is who is
  /// charged, and the two are only ever different for an agency's client.
  payerOrgId String?

  /// The shared provider subscription this client is a quantity on.
  ///
  /// An agency pays for its clients as one subscription per plan with a
  /// quantity, because a subscription per client would be an authorisation per
  /// client. Null for anything self-paid.
  billingGroupId Int?

  /// Who registered it — the person the billing emails go to.
  createdByUserId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waba         Waba?                 @relation(fields: [wabaId], references: [wabaId])
  plan         Plan?                 @relation("SubscriptionPlan", fields: [planRefId], references: [id], onDelete: Restrict)
  pendingPlan  Plan?                 @relation("SubscriptionPendingPlan", fields: [pendingPlanRefId], references: [id], onDelete: Restrict)
  payments     SubscriptionPayment[]
  billingGroup AgencyBillingGroup?   @relation(fields: [billingGroupId], references: [id], onDelete: SetNull)

  // An organisation has at most one subscription that is not tied to a single
  // account. `@@unique([wabaId, ssoOrgId])` cannot say that — Postgres treats
  // NULLs as distinct, so it allows two organisation-level rows and with them
  // two mandates and two debits a month. The constraint that does say it is a
  // partial unique index, `Subscription_org_key`, created in
  // `20260828100000_org_billing_and_agency`. Prisma cannot express a partial
  // index, so `migrate dev` reports it as drift; keep it.
  @@unique([wabaId, ssoOrgId])
  @@index([planRefId])
  @@index([pendingPlanRefId])
  @@index([ssoOrgId])
  @@index([status])
  @@index([payerOrgId])
  @@index([billingGroupId])
}

/// One mandate an agency holds, for one plan, covering several clients.
///
/// A subscription per client would mean an authorisation per client, which
/// nobody would sit through. Instead an agency holds one provider subscription
/// per plan it uses, and the quantity is how many of its clients are on that
/// plan: six on Growth and two on Business is two mandates, at quantity six and
/// two.
///
/// The client's own `Subscription` row is still what every limit and paywall
/// check reads. This is only how the money is taken.
model AgencyBillingGroup {
  id Int @id @default(autoincrement())

  /// The agency being charged.
  agencyOrgId String
  /// The plan its clients on this group are on.
  planRefId   Int

  razorpayCustomerId     String?
  razorpaySubscriptionId String  @unique
  /// The provider plan charged, recorded per group so a later price change
  /// cannot rewrite what this agency agreed to.
  planId                 String

  /// How many clients this is charging for. Kept here rather than counted
  /// from the subscriptions each time: it is what was last sent to the
  /// provider, and a disagreement with the row count is a bug worth seeing.
  quantity Int @default(0)

  status SubscriptionStatus @default(created)

  currentStart DateTime?
  currentEnd   DateTime?

  cancelAtCycleEnd Boolean   @default(false)
  cancelledAt      DateTime?

  /// The hosted authorisation page, until the mandate is registered.
  shortUrl String?

  createdByUserId Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan          Plan                  @relation("BillingGroupPlan", fields: [planRefId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]
  payments      SubscriptionPayment[]

  /// One group per agency and plan. A second would be a second mandate for
  /// the same thing.
  @@unique([agencyOrgId, planRefId])
  @@index([agencyOrgId])
  @@index([status])
}

/// What was actually taken, and how.
///
/// Razorpay is the ledger; this is the copy the console can show without a
/// round trip to their API on every page load, and the answer to "what was I
/// charged, when, on which card" once a payment scrolls out of their dashboard.
model SubscriptionPayment {
  id Int @id @default(autoincrement())

  /// The subscription charged, for anything self-paid.
  ///
  /// Null where the debit was an agency's group: one payment covers several
  /// clients, so it belongs to the group rather than to any one of them.
  subscriptionId Int?
  /// The agency's group charged, when it was one of those instead.
  billingGroupId Int?

  /// Razorpay's payment id. Unique because their webhooks retry, and a
  /// replayed `subscription.charged` must not become a second row.
  razorpayPaymentId String  @unique
  razorpayInvoiceId String?

  /// In the smallest currency unit, as Razorpay sends it — paise for INR.
  /// Stored as an integer on purpose: money in a float is money lost.
  amount   Int
  currency String @default("INR")

  /// `captured`, `authorized`, `failed` — Razorpay's own vocabulary.
  status String

  /// `card`, `upi`, `netbanking`, `wallet`, `emandate`.
  method String?

  /// Enough to recognise the instrument, and no more: "Visa ···· 4242",
  /// "HDFC Bank", a UPI handle. No PAN, no token, nothing that could be
  /// replayed — the instrument itself never leaves Razorpay.
  methodDetail String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())

  subscription Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  billingGroup AgencyBillingGroup? @relation(fields: [billingGroupId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([billingGroupId])
}

/// Every Razorpay webhook, kept for idempotency and for answering "what did
/// they actually send us" without a support ticket.
model SubscriptionEvent {
  id      Int    @id @default(autoincrement())
  /// Razorpay's event id. Their webhooks retry, so this is the guard against
  /// processing the same charge twice.
  eventId String @unique
  event   String

  ssoOrgId               String?
  razorpaySubscriptionId String?
  payload                Json

  createdAt DateTime @default(now())

  @@index([ssoOrgId, createdAt])
}

enum MessageType {
  text
  image
  video
  audio
  document
  template
  interactive
  location
  reaction
  contacts
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
  DELETED
  DISABLED
  IN_APPEAL
  PAUSED
  PENDING_DELETION
  ARCHIVED
}

enum TemplateCategory {
  AUTHENTICATION
  MARKETING
  UTILITY
}

enum MessageStatus {
  sent
  delivered
  read
  failed
}

model Message {
  id            Int           @id @default(autoincrement())
  metaMessageId String?       @unique
  phoneNumberId String
  to            String
  type          MessageType
  payload       Json
  status        MessageStatus @default(sent)
  userId        Int
  ssoOrgId      String
  /// Template used, for `type = template` only. Denormalised out of `payload`
  /// because per-template analytics cannot scan a JSON column.
  templateName  String?
  /// When each status landed, written by the status webhook. `updatedAt` alone
  /// cannot answer "how long until it was read" — it only holds the last change.
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  /// Meta's reason for a failure, so the analytics can rank causes instead of
  /// just counting failures. Its short title ("Re-engagement message"), which
  /// is what groups usefully — the sentence explaining it lives in
  /// `failureDetail`.
  failureReason String?
  /// Meta's numeric error code, e.g. 131047. Identifies the failure exactly,
  /// and is what their error-code reference is indexed by.
  failureCode   Int?
  /// Meta's own explanation of the failure — "more than 24 hours have passed
  /// since the customer last replied to this number" — shown to the sender,
  /// who cannot act on a four-word title.
  failureDetail String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  /// Every analytics query is "this organisation, this date range".
  @@index([ssoOrgId, createdAt])
  /// Per-number breakdowns, and the WABA filter, which joins through the number.
  @@index([phoneNumberId])
  @@index([ssoOrgId, templateName])
  /// The outbound half of an inbox thread: this organisation's sends from one
  /// number to one recipient, in order.
  @@index([ssoOrgId, phoneNumberId, to, createdAt])
}

model MessageTemplate {
  id             Int              @id @default(autoincrement())
  metaTemplateId String
  wabaId         String
  name           String
  language       String
  category       TemplateCategory
  status         TemplateStatus   @default(PENDING)
  components     Json
  rejectedReason String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  waba Waba @relation(fields: [wabaId], references: [wabaId])

  @@unique([wabaId, name, language])
}

model Contact {
  id         Int       @id @default(autoincrement())
  ssoOrgId   String
  phone      String
  name       String?
  email      String?
  optedOut   Boolean   @default(false)
  /// When the opt-out happened. The flag alone cannot be trended — it says
  /// what is true now, not when it became true, and that is not backfillable.
  optedOutAt DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([ssoOrgId, phone])
  /// Contact growth over a date range.
  @@index([ssoOrgId, createdAt])
}

model InboundMessage {
  id            Int      @id @default(autoincrement())
  metaMessageId String   @unique
  wabaId        String
  phoneNumberId String
  from          String
  senderName    String?
  type          String
  payload       Json
  timestamp     DateTime
  createdAt     DateTime @default(now())

  waba Waba @relation(fields: [wabaId], references: [wabaId])

  /// Inbound volume per WABA over a date range.
  @@index([wabaId, createdAt])
  /// One conversation's replies, newest first. The inbox reads a thread by the
  /// number it arrived on and who sent it — there is no conversation id on the
  /// row, because a WABA held by two organisations has two of them.
  @@index([phoneNumberId, from, timestamp])
}

enum ConversationStatus {
  open
  closed
}

enum ConversationDirection {
  inbound
  outbound
}

/// One thread in the inbox: this organisation, this number, this customer.
///
/// Nothing here cannot be derived from `Message` and `InboundMessage` — and
/// deriving it is exactly the problem. A conversation list is "the newest
/// message per counterparty across two tables", which no index answers and
/// which has to be recomputed on every poll. This row is that answer, written
/// once as each message lands.
///
/// Keyed per organisation rather than per WABA. An account can be connected by
/// several organisations (`WabaOrganisation`), and each one has its own unread
/// count, its own assignment and its own idea of whether the thread is dealt
/// with — the same reason the notification feed writes a row per organisation.
model Conversation {
  id            Int     @id @default(autoincrement())
  ssoOrgId      String
  /// The account the number belongs to. Denormalised so the WABA filter and an
  /// API key's WABA scope do not have to join through `WabaPhoneNumber`.
  wabaId        String
  phoneNumberId String
  /// The customer, digits only. Meta reports `from` without a leading `+` and
  /// callers send `to` either way, so both are normalised to one form before
  /// they reach this column — otherwise the same person opens two threads.
  contactPhone  String
  /// The WhatsApp profile name from the last reply. A customer who has never
  /// written has none, which is why the list falls back to the number.
  contactName   String?

  lastMessageAt DateTime
  lastDirection ConversationDirection
  /// A one-line summary of the last message, for the list.
  ///
  /// Denormalised because the alternative is reading a JSON payload per row on
  /// every page of the list, for a string that never changes once written.
  lastPreview   String?

  /// When the customer last wrote. This, and not `lastMessageAt`, is what the
  /// 24-hour customer service window is measured from — the window is about
  /// their last reply, and our own sends must not extend it.
  lastInboundAt DateTime?

  /// Unread replies since `lastReadAt`. A counter rather than a query, for the
  /// same reason as the preview: the sidebar badge is on every page.
  unreadCount Int       @default(0)
  lastReadAt  DateTime?

  status         ConversationStatus @default(open)
  /// Who on the team is dealing with this, if the team works that way.
  assigneeUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waba Waba @relation(fields: [wabaId], references: [wabaId], onDelete: Cascade)

  /// One thread per customer per number per organisation. This is what makes
  /// the write path an upsert instead of a read-then-write race.
  @@unique([ssoOrgId, phoneNumberId, contactPhone])
  /// The list itself: an organisation's threads, newest activity first.
  @@index([ssoOrgId, lastMessageAt])
  /// The same list filtered to open or closed.
  @@index([ssoOrgId, status, lastMessageAt])
  /// Deleting an account, and the WABA filter.
  @@index([wabaId])
}

/// A quality rating as Meta reported it, kept as a series.
///
/// WabaPhoneNumber.qualityRating is overwritten on every sync, so the history
/// is lost the moment it changes — and a drop from GREEN to RED matters mostly
/// for when it happened. Written by the phone_number_quality_update webhook.
model PhoneQualityEvent {
  id            Int      @id @default(autoincrement())
  phoneNumberId String
  wabaId        String
  /// GREEN / YELLOW / RED / UNKNOWN, as Meta words it.
  qualityRating String
  /// Meta's messaging limit tier at the time, when it sends one.
  limitTier     String?
  createdAt     DateTime @default(now())

  @@index([phoneNumberId, createdAt])
  @@index([wabaId, createdAt])
}

model WebhookEvent {
  id        Int      @id @default(autoincrement())
  eventType String
  wabaId    String
  payload   Json
  processed Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())

  WebhookDelivery WebhookDelivery[]
}

/// A customer's own HTTPS endpoint, which we post events to.
///
/// The other direction from `WebhookEvent`: that is what Meta tells us, this
/// is what we forward on to the integrator's backend. Scoped to one WABA the
/// way an API key is — an endpoint hears about one account, never everything
/// the organisation has connected.
model WebhookEndpoint {
  id       Int      @id @default(autoincrement())
  /// Who created it. Kept for the "your endpoint was switched off" email,
  /// which needs an address and cannot get one from an organisation id.
  userId   Int
  ssoOrgId String
  wabaId   String
  url      String
  /// A name for the reader — "Order service (staging)".
  label    String?
  /// Signing secret, encrypted at rest (AES-256-GCM), and optional.
  ///
  /// Without one we post the body unsigned and send no signature header, which
  /// is what an endpoint behind its own network boundary or a shared-secret
  /// path parameter wants. With one, every delivery carries an HMAC the
  /// receiver can check, and the value is never readable again.
  secret   String?
  /// Event kinds subscribed to (`inbound_message`, `status_update`,
  /// `template_status`, `account_update`). Empty means every kind.
  events   String[] @default([])
  status   Boolean  @default(true)

  /// Consecutive give-ups. Reset by any delivery that succeeds; an endpoint
  /// that reaches the limit is disabled rather than retried forever.
  failureCount  Int       @default(0)
  /// When we switched it off ourselves. Null for one switched off by a person.
  disabledAt    DateTime?
  lastSuccessAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User              @relation(fields: [userId], references: [id])
  waba       Waba              @relation(fields: [wabaId], references: [wabaId], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([ssoOrgId])
  @@index([wabaId, status])
}

/// One attempt-set at posting one event to one endpoint.
///
/// The outbox: `processPayload` writes rows and returns, and delivery happens
/// on the sweep. Meta's POST must be answered in milliseconds, so a customer's
/// slow endpoint cannot be allowed to hold that request open.
model WebhookDelivery {
  id         Int    @id @default(autoincrement())
  endpointId Int
  /// The stored Meta event this came from. Null for a test ping, which has no
  /// event behind it.
  eventId    Int?
  /// The outbound event name, e.g. `status_update` or `endpoint.test`.
  eventType  String
  /// Exactly what was posted, so a redelivery sends the same bytes.
  payload    Json
  /// pending | sent | failed | abandoned
  status     String @default("pending")
  /// Attempts made so far. 0 until the sweep first picks the row up.
  attempts   Int    @default(0)

  /// When the sweep may try (again). Null once the row is settled.
  retryAt      DateTime?
  /// HTTP status the endpoint answered with, when it answered at all.
  responseCode Int?
  /// First 500 characters of a non-2xx body, or the transport error.
  error        String?
  durationMs   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event    WebhookEvent?   @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([endpointId, createdAt])
  /// The sweep's query: rows due for an attempt.
  @@index([status, retryAt])
}

/// A browser (or app) registration for Firebase Cloud Messaging. One row per
/// device: the same person signed in on a laptop and a phone has two.
model DeviceToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  /// Organisation the device was registered under, so a push about one
  /// organisation never reaches a device signed in to another.
  ssoOrgId   String
  /// The FCM registration token. Unique because Firebase reissues the same
  /// token to the same browser, and re-registering must update, not duplicate.
  token      String   @unique
  platform   String   @default("web")
  userAgent  String?
  /// Refreshed on every registration, so stale devices can be pruned.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([ssoOrgId])
}

/// One entry in a person's notification feed — what the bell in the console
/// shows.
///
/// Written whether or not a push was delivered: a device asleep, a browser
/// that never granted permission, or a deployment with no Firebase credentials
/// must not lose the event. Push is the interruption; this table is the record.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  /// Organisation the event belongs to, so switching organisation does not
  /// show another one's activity. Null means "not tied to an organisation" —
  /// those appear whichever one is selected.
  ssoOrgId  String?
  /// Matches the preference columns — inboundMessage, templateStatus,
  /// messageFailed — plus 'system' for anything outside those three.
  kind      String
  title     String
  body      String
  /// Where clicking it should land, e.g. "/messages/42".
  link      String?
  /// Null until the person has seen it. Drives the unread count on the bell.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  /// The feed query: this user's rows, newest first.
  @@index([userId, createdAt])
  /// The unread count, which runs on every page load.
  @@index([userId, readAt])
}

/// Per-user opt-outs. A missing row means every notification is on, so a new
/// user needs no seeding.
model NotificationPreference {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique
  /// A customer replied on WhatsApp.
  inboundMessage      Boolean  @default(true)
  /// Meta approved, rejected or paused a template.
  templateStatus      Boolean  @default(true)
  /// The same, by email. Separate columns rather than one switch: a person may
  /// want a push for every reply but only an email when Meta rejects a
  /// template.
  emailTemplateStatus Boolean  @default(true)
  /// Yesterday's activity, including anything that failed to deliver. On by
  /// default: it is how a failed send reaches anyone now that nothing is
  /// mailed or pushed as it happens.
  emailDailySummary   Boolean  @default(true)
  /// A weekly activity summary, off until asked for.
  emailWeeklySummary  Boolean  @default(false)
  /// Product news and onboarding tips — marketing, so opt-in and unsubscribable.
  emailProductNews    Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

/// Addresses SES told us to stop mailing. Bounces and complaints arrive on the
/// SNS feedback topic; sending to a suppressed address again damages the
/// domain's reputation, so every send checks this table first.
model MailSuppression {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  /// bounce | complaint | unsubscribe | manual
  reason    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One row per email we send, so a support question ("did I get told?") has an
/// answer, and so a retry cannot double-send a digest.
model MailLog {
  id        Int       @id @default(autoincrement())
  userId    Int?
  email     String
  /// The template key, e.g. "template.status" or "digest.failed-sends".
  kind      String
  subject   String
  /// sent | suppressed | skipped | failed | abandoned
  status    String
  /// SES message id, for tracing a delivery with AWS support.
  messageId String?
  error     String?
  /// Delivery attempts made, including the first. A failed row is retried by
  /// the sweep until this passes the retry limit, then it is `abandoned`.
  attempts  Int       @default(1)
  /// When the sweep may try again. Null once the row is settled.
  retryAt   DateTime?
  /// What the message was made of, so a retry can rebuild it. Written only for
  /// a row awaiting retry, and cleared the moment it is settled — a support
  /// message body is the sender's content, not something to keep on file.
  payload   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([kind, createdAt])
  /// The sweep's query: rows due for another attempt.
  @@index([status, retryAt])
}
