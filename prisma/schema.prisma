// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  ssoId     String   @unique
  /// Contact details copied from SSO at sign-in. Held locally because every
  /// notification email is triggered by a webhook or a scheduled job, where
  /// there is no user token to read the SSO profile with.
  email     String?
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())

  UserWhatsapp UserWhatsapp[]
  UserApiKey   UserApiKey[]
  Waba         Waba[]
  Message      Message[]
  DeviceToken  DeviceToken[]
  Notification Notification[]

  NotificationPreference NotificationPreference?
}

model UserWhatsapp {
  id          Int      @id @default(autoincrement())
  userId      Int
  businessId  String
  wabaId      String
  accessToken String // Encrypted (AES-256-GCM)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  waba Waba @relation(fields: [wabaId], references: [wabaId])

  @@unique([userId, wabaId])
}

model Waba {
  id                       Int      @id @default(autoincrement())
  wabaId                   String   @unique
  name                     String?
  currency                 String?
  timezoneId               String?
  messageTemplateNamespace String?
  userId                   Int
  ssoOrgId                 String
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id])
  UserWhatsapp    UserWhatsapp[]
  WabaPhoneNumber WabaPhoneNumber[]
  InboundMessage  InboundMessage[]
  MessageTemplate MessageTemplate[]
  UserApiKey      UserApiKey[]
}

model WabaPhoneNumber {
  id                     Int       @id @default(autoincrement())
  phoneNumberId          String    @unique
  verifiedName           String
  codeVerificationStatus String
  displayPhoneNumber     String
  qualityRating          String
  platformType           String
  throughputLevel        String
  lastOnboardedTime      DateTime?
  wabaId                 String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  waba Waba @relation(fields: [wabaId], references: [wabaId])
}

model UserApiKey {
  id        Int      @id @default(autoincrement())
  userId    Int
  ssoOrgId  String
  accessKey String   @unique
  secretKey String // Encrypted
  /// The WABA this key may act on. A key reaches one account, never the whole
  /// organisation. Nullable only for keys issued before scoping existed, and
  /// those are refused at authentication rather than left org-wide.
  wabaId    String?
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation(fields: [userId], references: [id])
  waba Waba? @relation(fields: [wabaId], references: [wabaId])

  @@index([wabaId])
}

enum MessageType {
  text
  image
  video
  audio
  document
  template
  interactive
  location
  reaction
  contacts
}

enum TemplateStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
  DELETED
  DISABLED
  IN_APPEAL
  PAUSED
  PENDING_DELETION
  ARCHIVED
}

enum TemplateCategory {
  AUTHENTICATION
  MARKETING
  UTILITY
}

enum MessageStatus {
  sent
  delivered
  read
  failed
}

model Message {
  id            Int           @id @default(autoincrement())
  metaMessageId String?       @unique
  phoneNumberId String
  to            String
  type          MessageType
  payload       Json
  status        MessageStatus @default(sent)
  userId        Int
  ssoOrgId      String
  /// Template used, for `type = template` only. Denormalised out of `payload`
  /// because per-template analytics cannot scan a JSON column.
  templateName  String?
  /// When each status landed, written by the status webhook. `updatedAt` alone
  /// cannot answer "how long until it was read" — it only holds the last change.
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  /// Meta's reason for a failure, so the analytics can rank causes instead of
  /// just counting failures.
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  /// Every analytics query is "this organisation, this date range".
  @@index([ssoOrgId, createdAt])
  /// Per-number breakdowns, and the WABA filter, which joins through the number.
  @@index([phoneNumberId])
  @@index([ssoOrgId, templateName])
}

model MessageTemplate {
  id             Int              @id @default(autoincrement())
  metaTemplateId String
  wabaId         String
  name           String
  language       String
  category       TemplateCategory
  status         TemplateStatus   @default(PENDING)
  components     Json
  rejectedReason String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  waba Waba @relation(fields: [wabaId], references: [wabaId])

  @@unique([wabaId, name, language])
}

model Contact {
  id         Int       @id @default(autoincrement())
  ssoOrgId   String
  phone      String
  name       String?
  email      String?
  optedOut   Boolean   @default(false)
  /// When the opt-out happened. The flag alone cannot be trended — it says
  /// what is true now, not when it became true, and that is not backfillable.
  optedOutAt DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([ssoOrgId, phone])
  /// Contact growth over a date range.
  @@index([ssoOrgId, createdAt])
}

model InboundMessage {
  id            Int      @id @default(autoincrement())
  metaMessageId String   @unique
  wabaId        String
  phoneNumberId String
  from          String
  senderName    String?
  type          String
  payload       Json
  timestamp     DateTime
  createdAt     DateTime @default(now())

  waba Waba @relation(fields: [wabaId], references: [wabaId])

  /// Inbound volume per WABA over a date range.
  @@index([wabaId, createdAt])
}

/// A quality rating as Meta reported it, kept as a series.
///
/// WabaPhoneNumber.qualityRating is overwritten on every sync, so the history
/// is lost the moment it changes — and a drop from GREEN to RED matters mostly
/// for when it happened. Written by the phone_number_quality_update webhook.
model PhoneQualityEvent {
  id            Int      @id @default(autoincrement())
  phoneNumberId String
  wabaId        String
  /// GREEN / YELLOW / RED / UNKNOWN, as Meta words it.
  qualityRating String
  /// Meta's messaging limit tier at the time, when it sends one.
  limitTier     String?
  createdAt     DateTime @default(now())

  @@index([phoneNumberId, createdAt])
  @@index([wabaId, createdAt])
}

model WebhookEvent {
  id        Int      @id @default(autoincrement())
  eventType String
  wabaId    String
  payload   Json
  processed Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())
}

/// A browser (or app) registration for Firebase Cloud Messaging. One row per
/// device: the same person signed in on a laptop and a phone has two.
model DeviceToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  /// Organisation the device was registered under, so a push about one
  /// organisation never reaches a device signed in to another.
  ssoOrgId   String
  /// The FCM registration token. Unique because Firebase reissues the same
  /// token to the same browser, and re-registering must update, not duplicate.
  token      String   @unique
  platform   String   @default("web")
  userAgent  String?
  /// Refreshed on every registration, so stale devices can be pruned.
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([ssoOrgId])
}

/// One entry in a person's notification feed — what the bell in the console
/// shows.
///
/// Written whether or not a push was delivered: a device asleep, a browser
/// that never granted permission, or a deployment with no Firebase credentials
/// must not lose the event. Push is the interruption; this table is the record.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  /// Organisation the event belongs to, so switching organisation does not
  /// show another one's activity. Null means "not tied to an organisation" —
  /// those appear whichever one is selected.
  ssoOrgId  String?
  /// Matches the preference columns — inboundMessage, templateStatus,
  /// messageFailed — plus 'system' for anything outside those three.
  kind      String
  title     String
  body      String
  /// Where clicking it should land, e.g. "/messages/42".
  link      String?
  /// Null until the person has seen it. Drives the unread count on the bell.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  /// The feed query: this user's rows, newest first.
  @@index([userId, createdAt])
  /// The unread count, which runs on every page load.
  @@index([userId, readAt])
}

/// Per-user opt-outs. A missing row means every notification is on, so a new
/// user needs no seeding.
model NotificationPreference {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique
  /// A customer replied on WhatsApp.
  inboundMessage      Boolean  @default(true)
  /// Meta approved, rejected or paused a template.
  templateStatus      Boolean  @default(true)
  /// An outbound message failed to deliver.
  messageFailed       Boolean  @default(true)
  /// The same three, by email. Separate columns rather than one switch: a
  /// person may want a push for every reply but only an email when Meta
  /// rejects a template.
  emailInboundMessage Boolean  @default(false)
  emailTemplateStatus Boolean  @default(true)
  emailMessageFailed  Boolean  @default(true)
  /// A weekly activity summary, off until asked for.
  emailWeeklySummary  Boolean  @default(false)
  /// Product news and onboarding tips — marketing, so opt-in and unsubscribable.
  emailProductNews    Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

/// Addresses SES told us to stop mailing. Bounces and complaints arrive on the
/// SNS feedback topic; sending to a suppressed address again damages the
/// domain's reputation, so every send checks this table first.
model MailSuppression {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  /// bounce | complaint | unsubscribe | manual
  reason    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// One row per email we send, so a support question ("did I get told?") has an
/// answer, and so a retry cannot double-send a digest.
model MailLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String
  /// The template key, e.g. "template.status" or "digest.failed-sends".
  kind      String
  subject   String
  /// sent | suppressed | skipped | failed
  status    String
  /// SES message id, for tracing a delivery with AWS support.
  messageId String?
  error     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([kind, createdAt])
}
